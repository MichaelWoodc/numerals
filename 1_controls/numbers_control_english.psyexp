        <Routine name="reprimand">
            <RoutineSettingsComponent name="reprimand" plugin="None">
                <Param name="name" val="reprimand" valType="code" updates="None" plugin="None"/>
                <Param name="stopVal" val="" valType="code" updates="constant" plugin="None"/>
