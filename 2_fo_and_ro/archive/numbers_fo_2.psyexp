                <Param name="End Routine" val="import subprocess&#10;import platform&#10;&#10;number_trials = correct + incorrect&#10;language = expInfo['Language']&#10;&#10;script_path = os.path.join(os.getcwd(), &quot;numbers_ro_lastrun.py&quot;)&#10;&#10;args = [&#10;    sys.executable,&#10;    script_path,&#10;    str(number_trials),&#10;    str(language),&#10;    str(correct),&#10;    str(incorrect)&#10;]&#10;&#10;system = platform.system()&#10;&#10;# ------------------------&#10;# WINDOWS&#10;# ------------------------&#10;if system == &quot;Windows&quot;:&#10;    DETACHED_PROCESS = 0x00000008&#10;    CREATE_NEW_PROCESS_GROUP = 0x00000200&#10;&#10;    subprocess.Popen(&#10;        args,&#10;        cwd=os.getcwd(),&#10;        creationflags=DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP,&#10;        close_fds=True&#10;    )&#10;&#10;# ------------------------&#10;# macOS / Linux&#10;# ------------------------&#10;else:&#10;    subprocess.Popen(&#10;        args,&#10;        cwd=os.getcwd(),&#10;        start_new_session=True,&#10;        close_fds=True&#10;    )" valType="extendedCode" updates="constant" plugin="None"/>
